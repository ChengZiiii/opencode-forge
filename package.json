{
  "name": "@sorenllm/opencode-forge",
  "version": "0.2.1",
  "description": "Single general-purpose forge agent for opencode with two orthogonal harnesses: a plan harness (file-backed plans in .opencode/plan/, approve/close confirmation gates, tick discipline, hard write-ban while planning) and a goal harness (autonomous, host-verified objectives in .opencode/goal/ — idle continuation under turn/minute budgets, shell + file-contract checks re-run by the plugin at the completion gate, no-progress/transport/budget auto-pause, queueing).",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./server": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "bundle": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && bun build ./plugin.ts --outfile ./dist/index.js --target node --format esm",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plan",
    "planning",
    "workflow",
    "single-agent",
    "goal"
  ],
  "license": "MIT",
  "author": "chengsongren",
  "homepage": "https://github.com/ChengZiiii/opencode-forge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChengZiiii/opencode-forge.git"
  },
  "bugs": {
    "url": "https://github.com/ChengZiiii/opencode-forge/issues"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.0",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  },
  "engines": {
    "opencode": "^1.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
